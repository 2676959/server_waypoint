                        require(
                                support.getWaypointWorld().getDimId().equals(Level.NETHER),
                                "Add owner wrong");
                        var personal =
                                new xaero.common.minimap.waypoints.Waypoint(
                                        17, 85, -19, "personal-add", "LA", 1);
                        var marker = support.convertWaypoint(personal, true, "Bases", 8.0);
                        prev[0] = screen();
                        new xaero.map.mods.gui.WaypointReader()
                                        .getRightClickOptions(
                                                marker,
                                                (xaero.map.gui.IRightClickableElement) prev[0])
                                        .stream()
                                        .filter(o -> GameApi.label(o).equals("Add to server"))
                                        .findFirst()
                                        .orElseThrow()
                                        .onSelected(prev[0]);
                        require(
                                call(get(screen(), "dimensionField"), "getResolvedValue")
                                        .equals("minecraft:the_nether"),
                                "Add wrong dimension");
                        text(screen(), "nameEditBox", "live-added");
                        text(screen(), "initialsEditBox", "LA");
                        screen().tick();
                        click(screen(), get(screen(), "addButton"));
                        log("MAP Add-to-server submitted; idle pause=" + screen().isPauseScreen());
                    });
            waitScreen(prev[0]);
            client(
                    () -> {
                        var w = saved("minecraft:the_nether", "live-added");
                        require(
                                w != null && w.x() == 17 && w.y() == 85 && w.z() == -19,
                                "added coordinates wrong");
                        require(
                                saved("minecraft:overworld", "live-added") == null,
                                "added to player dimension");
                        log(
                                "MAP Add-to-server completed through real command and synced-data"
                                        + " return; owner Nether, coordinates preserved");
                    });
        } else if (op.equals("map")) {
            client(
                    () -> {
                        GameApi.syncVoxel();
                        _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(
                                mc,
                                new xaero.map.gui.GuiMap(
                                        null,
                                        null,
                                        xaero.map.WorldMapSession.getCurrentSession()
                                                .getMapProcessor(),
                                        mc.player));
                    });
            Thread.sleep(1000);
            client(
                    () -> {
                        var support = xaero.map.mods.SupportMods.xaeroMinimap;
                        log(
                                "MAP owner="
                                        + support.getWaypointWorld()
                                        + " viewed="
                                        + support.getMapWaypointWorld());
                        for (var w : support.getWaypoints())
                            log(
                                    "MARKER name="
                                            + ((_959.server_waypoint.access
                                                                    .XaerosWorldMapWaypointAccess)
                                                            w)
                                                    .sw$getRawName()
                                            + " set="
                                            + w.getSetName());
                    });
        } else if (op.equals("dump")) {
            client(
                    () -> {
                        log(
                                "SCREEN "
                                        + (screen() == null
                                                ? "null"
                                                : screen().getClass().getName()));
                        log("CLIENT " + WaypointClientMod.getInstance().snapshotWaypointData(100));
                        log("XAERO_SUPPORT " + xaero.map.mods.SupportMods.xaeroMinimap);
                    });
        } else throw new IllegalArgumentException(op);
        writeResult("PASS\n");
    }
}
