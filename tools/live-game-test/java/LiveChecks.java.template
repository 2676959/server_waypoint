public class LiveChecks {
    static Path home;
    static Path result;
    static Minecraft mc;

    public static void start(String dir, String op, String resultFile) {
        home = Path.of(dir);
        result = Path.of(resultFile);
        mc = Minecraft.getInstance();
        Thread t =
                new Thread(
                        () -> {
                            try {
                                run(op);
                                log("PASS " + op);
                            } catch (Throwable e) {
                                try {
                                    java.io.StringWriter s = new java.io.StringWriter();
                                    e.printStackTrace(new java.io.PrintWriter(s));
                                    writeResult("FAIL\n" + s);
                                } catch (Exception ignored) {
                                }
                            }
                        },
                        "SW live verification");
        t.setDaemon(true);
        t.start();
    }

    public static void quit() {
        Minecraft client = Minecraft.getInstance();
        client.execute(client::stop);
    }

    static void writeResult(String state) throws Exception {
        Path temp = result.resolveSibling(result.getFileName() + ".writing");
        Files.writeString(temp, state);
        Files.move(temp, result, StandardCopyOption.ATOMIC_MOVE);
    }

    static Screen screen() {
        return GameApi.screen(mc);
    }

    static void log(String s) throws Exception {
        Files.writeString(
                home.resolve("events.log"),
                s + "\n",
                StandardOpenOption.CREATE,
                StandardOpenOption.APPEND);
        System.out.println("SW_LIVE " + s);
    }

    interface Task {
        void run() throws Exception;
    }

    static void client(Task task) throws Exception {
        CompletableFuture<Void> f = new CompletableFuture<>();
        mc.execute(
                () -> {
                    try {
                        task.run();
                        f.complete(null);
                    } catch (Throwable e) {
                        f.completeExceptionally(e);
                    }
                });
        f.get(120, TimeUnit.SECONDS);
    }

    static void server(Task task) throws Exception {
        CompletableFuture<Void> f = new CompletableFuture<>();
        mc.getSingleplayerServer()
                .execute(
                        () -> {
                            try {
                                task.run();
                                f.complete(null);
                            } catch (Throwable e) {
                                f.completeExceptionally(e);
                            }
                        });
        f.get(120, TimeUnit.SECONDS);
    }

    static void clickLabel(String key) {
        String label = net.minecraft.network.chat.Component.translatable(key).getString();
        var button = screen().children().stream()
                .filter(child -> child instanceof net.minecraft.client.gui.components.AbstractWidget widget
                        && widget.getMessage().getString().equals(label))
                .map(child -> (net.minecraft.client.gui.components.AbstractWidget) child)
                .findFirst().orElseThrow();
        require(GameApi.click(screen(), button), "Button did not handle click: " + label);
    }

    static void noSharePrompt(String context) {
        require(!(screen() instanceof ConfirmScreen)
                && !(screen() instanceof _959.server_waypoint.common.client.gui.screens.WaypointAddScreen),
                context + ": " + screen());
    }

    static void require(boolean b, String s) {
        if (!b) throw new AssertionError(s);
    }

    static Object get(Object o, String n) throws Exception {
        for (Class<?> c = o.getClass(); c != null; c = c.getSuperclass()) {
            try {
                Field f = c.getDeclaredField(n);
                f.setAccessible(true);
                return f.get(o);
            } catch (NoSuchFieldException e) {
            }
        }
        throw new NoSuchFieldException(n);
    }

    static void set(Object o, String n, Object v) throws Exception {
        for (Class<?> c = o.getClass(); c != null; c = c.getSuperclass()) {
            try {
                Field f = c.getDeclaredField(n);
                f.setAccessible(true);
                f.set(o, v);
                return;
            } catch (NoSuchFieldException e) {
            }
        }
        throw new NoSuchFieldException(n);
    }

    static Object call(Object o, String name, Object... args) throws Exception {
        for (Class<?> c = o.getClass(); c != null; c = c.getSuperclass())
            for (Method m : c.getDeclaredMethods())
                if (m.getName().equals(name) && m.getParameterCount() == args.length) {
                    m.setAccessible(true);
                    return m.invoke(o, args);
                }
        throw new NoSuchMethodException(name);
    }

    static SimpleWaypoint wp(String name) {
        return new SimpleWaypoint(
                name,
                "Fancy " + name,
                "FX",
                new WaypointPos(31, 75, -42),
                0x33AA55,
                135,
                true,
                List.of("alpha", "beta"),
                "Preserve full metadata",
                NamespacedId.parse("minecraft:diamond"));
    }

    static String value(Object screen, String field) throws Exception {
        return ((net.minecraft.client.gui.components.EditBox) get(screen, field)).getValue();
    }

    static void text(Object screen, String field, String v) throws Exception {
        ((net.minecraft.client.gui.components.EditBox) get(screen, field)).setValue(v);
    }

    static void click(Screen screen, Object obj) throws Exception {
        net.minecraft.client.gui.components.AbstractWidget b =
                (net.minecraft.client.gui.components.AbstractWidget) obj;
        require(b.active && b.visible, "button inactive " + b.getMessage().getString());
        require(GameApi.click(screen, b), "click not handled " + b.getMessage().getString());
    }

    static void assertForm(Screen screen, String dim, String name) throws Exception {
        require(
                screen instanceof _959.server_waypoint.common.client.gui.screens.WaypointEditScreen,
                "wrong screen " + screen);
        require(get(screen, "dimensionName").equals(dim), "wrong edit dimension");
        require(get(screen, "listName").equals("Bases"), "wrong list identity");
        require(get(screen, "listDisplayName").equals("Display Bases"), "wrong list label");
        require(value(screen, "nameEditBox").equals(name), "name not preserved");
        require(
                value(screen, "displayNameEditBox").equals("Fancy " + name),
                "display name not preserved");
        require(value(screen, "initialsEditBox").equals("FX"), "initials not preserved");
        require(
                value(screen, "descriptionEditBox").equals("Preserve full metadata"),
                "description not preserved");
        require(
                value(screen, "keywordsEditBox").contains("alpha")
                        && value(screen, "keywordsEditBox").contains("beta"),
                "keywords not preserved");
        require(
                call(get(screen, "iconPicker"), "getSelectedIcon")
                        .equals(NamespacedId.parse("minecraft:diamond")),
                "icon not preserved");
        require(screen.isPauseScreen(), "idle editor not pausing");
    }

    static SimpleWaypoint saved(String dim, String name) {
        return WaypointServerMod.getInstance()
                .getWaypointFileManager(dim)
                .getWaypointListByName("Bases")
                .getWaypointByName(name);
    }

    static void waitCached(String dimension, String name, boolean present) throws Exception {
        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(20);
        boolean[] matched = new boolean[1];
        while (System.nanoTime() < deadline) {
            client(
                    () ->
                            matched[0] =
                                    (_959.server_waypoint.common.client.integrations
                                                            .XaerosWorldMapWaypointHelper
                                                            .resolveSyncedEditTarget(
                                                                    dimension,
                                                                    _959.server_waypoint.common.util
                                                                            .SyncedWaypointName
                                                                            .formatSyncedName(
                                                                                    "Bases"),
                                                                    name,
                                                                    WaypointClientMod.getInstance())
                                                    != null)
                                            == present);
            if (matched[0]) {
                return;
            }
            Thread.sleep(50);
        }
        throw new AssertionError("Client cache did not receive " + dimension + "/Bases/" + name);
    }

    static void waitScreen(Screen prev) throws Exception {
        long end = System.currentTimeMillis() + 12000;
        while (screen() != prev && System.currentTimeMillis() < end) Thread.sleep(50);
        require(screen() == prev, "save did not receive successful response; screen=" + screen());
    }

    static void waitXaeroWorld() throws Exception {
        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(30);
        boolean[] ready = new boolean[1];
        while (System.nanoTime() < deadline) {
            client(
                    () -> {
                        var session =
                                _959.server_waypoint.common.util.XaeroMinimapHelper
                                        .getMinimapSession();
                        ready[0] =
                                session != null
                                        && session.getWorldManager().getCurrentWorld() != null;
                    });
            if (ready[0]) {
                return;
            }
            Thread.sleep(50);
        }
        throw new AssertionError("Xaero did not establish the active waypoint world");
    }

    static void run(String op) throws Exception {
        if (op.equals("create")) {
            client(() -> GameApi.create(mc, screen()));
            long end = System.currentTimeMillis() + 120000;
            while ((mc.player == null
                            || mc.level == null
                            || WaypointClientMod.getNetworkState()
                                    != WaypointClientMod.ClientNetworkState.SYNC_FINISHED)
                    && System.currentTimeMillis() < end) Thread.sleep(250);
            require(
                    mc.player != null
                            && mc.level != null
                            && WaypointClientMod.getNetworkState()
                                    == WaypointClientMod.ClientNetworkState.SYNC_FINISHED,
                    "integrated world did not finish sync");
            client(
                    () ->
                            _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(
                                    mc, null));
            waitXaeroWorld();
            log(
                    "WORLD playerDim="
                            + mc.level.dimension()
                            + " transport="
                            + WaypointClientMod.getNetworkState());
        } else if (op.equals("seed")) {
            client(
                    () ->
                            _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(
                                    mc, null));
            server(
                    () -> {
                        WaypointServerMod s = WaypointServerMod.getInstance();
                        for (String dim : List.of("minecraft:overworld", "minecraft:the_nether"))
                            for (String name : List.of("map-fixture", "voxel-fixture"))
                                require(
                                        s.addWaypoint(
                                                        dim,
                                                        "Bases",
                                                        "Display Bases",
                                                        wp(name),
                                                        r -> {})
                                                .status()
                                                .name()
                                                .equals("ADDED"),
                                        "seed failed");
                        s.saveAllWaypointFiles();
                        log("SERVER_STORE " + s.getWaypointFilesDir());
                    });
            for (String dimension : List.of("minecraft:overworld", "minecraft:the_nether")) {
                for (String name : List.of("map-fixture", "voxel-fixture")) {
                    waitCached(dimension, name, true);
                }
            }
            client(
                    () -> {
                        _959.server_waypoint.common.client.integrations.MapModIntegrations.syncNow(
                                _959.server_waypoint.core.network.upload.UploadTarget.XAERO,
                                WaypointClientMod.getInstance());
                    });
        } else if (op.equals("entrypoints")) {
            client(() -> {
                var session = _959.server_waypoint.common.util.XaeroMinimapHelper.getMinimapSession();
                var world = _959.server_waypoint.common.util.XaeroMinimapHelper.getMinimapWorld(session, Level.NETHER);
                world.setCurrentWaypointSetId("sw␟Bases");
                session.getWorldState().setCustomWorldPath(world.getFullPath());
                var menu = new xaero.common.gui.GuiWaypoints(xaero.common.HudMod.INSTANCE, session, null, null);
                _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(mc, menu);
                ((java.util.Set<Integer>) get(menu, "selectedListSet")).add(0);
                call(menu, "updateButtons");
                String name = ((xaero.common.minimap.waypoints.Waypoint) call(get(menu, "list"), "getWaypoint", 0)).getName();
                click(menu, get(menu, "editButton"));
                assertForm(screen(), "minecraft:the_nether", name);
                click(screen(), get(screen(), "cancelButton"));
                require(screen() == menu, "Minimap cancel lost parent");
                log("ENTRY Minimap Add/Edit opens complete server editor for selected owning dimension");
                ((java.util.Set<Integer>) get(menu, "selectedListSet")).add(1);
                call(menu, "updateButtons");
                click(menu, get(menu, "editButton"));
                require(screen() instanceof xaero.common.gui.GuiAddWaypoint, "Multiple selection lost native Minimap editor");
                screen().onClose();
                world.addWaypointSet("Personal");
                world.setCurrentWaypointSetId("Personal");
                world.getCurrentWaypointSet().add(new xaero.common.minimap.waypoints.Waypoint(1, 64, 3, "map-fixture", "MF", 12));
                var personal = new xaero.common.gui.GuiWaypoints(xaero.common.HudMod.INSTANCE, session, null, null);
                _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(mc, personal);
                ((java.util.Set<Integer>) get(personal, "selectedListSet")).add(0);
                call(personal, "updateButtons");
                click(personal, get(personal, "editButton"));
                require(screen() instanceof xaero.common.gui.GuiAddWaypoint, "Personal waypoint with matching name lost native editor");
                screen().onClose();
                world.setCurrentWaypointSetId("sw␟Bases");
                world.removeWaypointSet("Personal");
                session.getWorldState().setCustomWorldPath(null);
                log("ENTRY Minimap personal and multiple selection preserve native editor");
            });
            // @voxel-start
            client(() -> {
                GameApi.syncVoxel();
                var manager = com.mamiyaotaru.voxelmap.VoxelConstants.getVoxelMapInstance().getWaypointManager();
                var waypoint = manager.getWaypoints().stream().filter(w -> w.name.equals("sw␟Bases␟voxel-fixture")).findFirst().orElseThrow();
                var map = new com.mamiyaotaru.voxelmap.persistent.GuiPersistentMap(null);
                _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(mc, map);
                set(map, "selectedWaypoint", waypoint);
                boolean originalDimension = waypoint.inDimension;
                boolean originalWorld = waypoint.inWorld;
                waypoint.inDimension = true;
                waypoint.inWorld = true;
                set(map, "oldNorth", false);
                set(map, "mapCenterX", (float) waypoint.getX() + 0.5F);
                set(map, "mapCenterZ", (float) waypoint.getZ() + 0.5F);
                set(map, "centerX", 0);
                set(map, "centerY", 0);
                set(map, "top", 0);
                set(map, "guiToDirectMouse", 1.0F);
                set(map, "mouseDirectToMap", 0.0F);
                set(map, "guiToMap", 1.0F);
                call(map, "createPopup", 100, 100, 100, 100);
                var popup = ((java.util.List<?>) get(map, "popups")).get(0);
                Object edit = Arrays.stream((Object[]) get(popup, "entries")).filter(e -> {
                    try { return get(e, "name").equals("Edit on server"); } catch (Exception ex) { throw new RuntimeException(ex); }
                }).findFirst().orElseThrow();
                call(map, "popupAction", popup, get(edit, "action"));
                require(screen() instanceof _959.server_waypoint.common.client.gui.screens.WaypointEditScreen, "Voxel popup missing server editor");
                click(screen(), get(screen(), "cancelButton"));
                call(map, "clearPopups");
                set(map, "selectedWaypoint", null);
                set(map, "oldNorth", false);
                set(map, "centerX", 0);
                set(map, "centerY", 0);
                set(map, "top", 0);
                set(map, "guiToDirectMouse", 1.0F);
                set(map, "mouseDirectToMap", 0.0F);
                set(map, "guiToMap", 1.0F);
                set(map, "mapCenterX", 3000.0F);
                set(map, "mapCenterZ", -3000.0F);
                call(map, "createPopup", 100, 100, 100, 100);
                popup = ((java.util.List<?>) get(map, "popups")).get(0);
                Object add = Arrays.stream((Object[]) get(popup, "entries")).filter(e -> {
                    try { return get(e, "name").equals("Add to server"); } catch (Exception ex) { throw new RuntimeException(ex); }
                }).findFirst().orElseThrow();
                call(map, "popupAction", popup, get(add, "action"));
                require(screen() instanceof _959.server_waypoint.common.client.gui.screens.WaypointAddScreen, "Voxel popup missing server add");
                require(value(screen(), "xEditBox").equals("3000") && value(screen(), "zEditBox").equals("-3000"), "Voxel map location scaling changed coordinates");
                click(screen(), get(screen(), "cancelButton"));
                waypoint.inDimension = originalDimension;
                waypoint.inWorld = originalWorld;
                log("ENTRY Voxel popup Edit and empty-location Add use server forms");
            });
            // @voxel-end
            client(() -> {
                _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(mc, null);
                var session = _959.server_waypoint.common.util.XaeroMinimapHelper.getMinimapSession();
                var world = _959.server_waypoint.common.util.XaeroMinimapHelper.getMinimapWorld(session, Level.OVERWORLD);
                session.getWaypointSession().getSharing().shareWaypoint(null,
                        new xaero.common.minimap.waypoints.Waypoint(19, 66, -23, "share-test", "ST", 12), world);
                require(screen() instanceof ConfirmScreen, "Native Xaero share confirmation missing");
                clickLabel("gui.yes");
            });
            Thread.sleep(500);
            client(() -> {
                require(screen() instanceof ConfirmScreen, "Outgoing Xaero share did not prompt the sharer");
                clickLabel("gui.yes");
                require(screen() instanceof _959.server_waypoint.common.client.gui.screens.WaypointAddScreen, "Share confirmation missing add form");
                require(value(screen(), "nameEditBox").equals("share-test") && value(screen(), "xEditBox").equals("19"), "Share defaults lost");
                click(screen(), get(screen(), "cancelButton"));
            });
            client(() -> {
                _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(mc, null);
                String message = "xaero-waypoint:sw␟Bases␟map^min^fixture:MF:999:1:999:12:false:0:Internal";
                var share = _959.server_waypoint.common.client.integrations.SharedMapWaypoint.parse(message,
                        WaypointClientMod.getCurrentDimensionName(), 64);
                require(share != null && share.isOnServer(WaypointClientMod.getInstance()), "Missing encoded Xaero fixture");
                mc.player.connection.sendChat(message);
            });
            Thread.sleep(500);
            client(() -> noSharePrompt("Encoded existing Xaero share prompted despite stale coordinates"));
            // @voxel-start
            client(() -> mc.player.connection.sendChat("[name:sw␟Bases␟voxel-fixture, x:999, y:1, z:999, dim:minecraft:overworld]"));
            Thread.sleep(500);
            client(() -> noSharePrompt("Encoded existing Voxel share prompted despite stale coordinates"));
            client(() -> {
                var dimensions = new java.util.TreeSet<com.mamiyaotaru.voxelmap.util.DimensionContainer>();
                dimensions.add(com.mamiyaotaru.voxelmap.VoxelConstants.getVoxelMapInstance()
                        .getDimensionManager().getDimensionContainerByWorld(mc.player.level()));
                var draft = new com.mamiyaotaru.voxelmap.util.Waypoint("voxel-share", -19, 23, 67,
                        true, 1.0F, 0.0F, 0.0F, "star", "", dimensions);
                com.mamiyaotaru.voxelmap.util.CommandUtils.sendWaypoint(draft);
                require(screen() instanceof com.mamiyaotaru.voxelmap.gui.GuiSelectPlayer, "Native Voxel share screen missing");
                set(screen(), "allClicked", true);
                call(screen(), "accept", true);
            });
            Thread.sleep(500);
            client(() -> {
                require(screen() instanceof ConfirmScreen, "Outgoing Voxel share did not prompt after native screen close");
                clickLabel("gui.no");
                noSharePrompt("Declining a share did not close the prompt");
                com.mamiyaotaru.voxelmap.util.CommandUtils.sendCoordinate(-19, 67, 23);
                call(screen(), "sendMessageToPlayer", "SwLiveTest");
            });
            Thread.sleep(500);
            client(() -> {
                require(screen() instanceof ConfirmScreen, "Private Voxel share did not prompt the sender");
                clickLabel("gui.yes");
                require(screen() instanceof _959.server_waypoint.common.client.gui.screens.WaypointAddScreen, "Voxel confirmation missing server add form");
                require(value(screen(), "nameEditBox").isEmpty()
                        && value(screen(), "xEditBox").equals("-19")
                        && value(screen(), "yEditBox").equals("67")
                        && value(screen(), "zEditBox").equals("23"), "Voxel share defaults lost or scaled");
                click(screen(), get(screen(), "cancelButton"));
                log("ENTRY Voxel public/private share prompts, decline, defaults, and encoded identity suppression");
            });
            // @voxel-end
            log("ENTRY Xaero share confirmation, defaults, and encoded identity suppression");
        } else if (op.equals("load")) {
            client(() -> GameApi.load(mc));
            long end = System.currentTimeMillis() + 120000;
            while ((mc.player == null
                            || WaypointClientMod.getNetworkState()
                                    != WaypointClientMod.ClientNetworkState.SYNC_FINISHED)
                    && System.currentTimeMillis() < end) Thread.sleep(250);
            require(mc.player != null, "world not loaded");
            client(
                    () ->
                            _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(
                                    mc, null));
        } else if (op.equals("close")) {
            client(
                    () ->
                            _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(
                                    mc, null));
            server(() -> WaypointServerMod.getInstance().saveAllWaypointFiles());
            client(() -> GameApi.disconnect(mc));
        } else if (op.equals("map-save")) {
            final Screen[] previous = new Screen[1];
            client(
                    () -> {
                        _959.server_waypoint.common.client.integrations.XaerosMinimapWaypointHelper
                                .replaceAll(WaypointClientMod.getInstance());
                        var world =
                                _959.server_waypoint.common.util.XaeroMinimapHelper.getMinimapWorld(
                                        _959.server_waypoint.common.util.XaeroMinimapHelper
                                                .getMinimapSession(),
                                        Level.OVERWORLD);
                        String raw =
                                _959.server_waypoint.common.util.SyncedWaypointName
                                        .formatSyncedName("Bases");
                        world.setCurrentWaypointSetId(raw);
                        var original = world.getWaypointSet(raw).get(0);
                        var marker =
                                xaero.map.mods.SupportMods.xaeroMinimap.convertWaypoint(
                                        original, true, raw, 1.0);
                        Screen map =
                                screen() instanceof xaero.map.gui.GuiMap
                                        ? screen()
                                        : new xaero.map.gui.GuiMap(
                                                null,
                                                null,
                                                xaero.map.WorldMapSession.getCurrentSession()
                                                        .getMapProcessor(),
                                                mc.player);
                        _959.server_waypoint.common.client.util.MinecraftClientHelper.setScreen(
                                mc, map);
                        previous[0] = map;
                        var options =
                                new xaero.map.mods.gui.WaypointReader()
                                        .getRightClickOptions(
                                                marker, (xaero.map.gui.IRightClickableElement) map);
                        var edit =
                                options.stream()
                                        .filter(o -> GameApi.label(o).endsWith("Edit on server"))
                                        .findFirst()
                                        .orElseThrow();
                        require(edit.isActive(), "edit disabled");
                        edit.onSelected(map);
                        assertForm(screen(), "minecraft:overworld", "map-fixture");
                        text(screen(), "yEditBox", "76");
                        screen().tick();
                        click(screen(), get(screen(), "saveButton"));
                        require(!screen().isPauseScreen(), "pending save did not unpause");
                        log("MAP save submitted via screen mouse click; pending unpaused");
                    });
            waitScreen(previous[0]);
            client(
                    () -> {
                        var w = saved("minecraft:overworld", "map-fixture");
                        require(w.y() == 76, "changed y missing");
                        require(
                                w.displayName().equals("Fancy map-fixture")
                                        && w.description().equals("Preserve full metadata")
                                        && w.keywords().equals(List.of("alpha", "beta"))
                                        && w.icon().equals(NamespacedId.parse("minecraft:diamond"))
                                        && w.yaw() == 135
                                        && w.global(),
                                "metadata lost on save");
                        require(
                                saved("minecraft:the_nether", "map-fixture").y() == 75,
                                "wrong dimension modified");
                        log(
                                "MAP save acknowledged; Overworld y=76; Nether unchanged; metadata"
                                        + " intact");
                    });
        } else if (op.equals("select-nether")) {
            client(
                    () -> {
                        _959.server_waypoint.common.client.integrations.XaerosMinimapWaypointHelper
                                .replaceAll(WaypointClientMod.getInstance());
                        var session =
                                _959.server_waypoint.common.util.XaeroMinimapHelper
                                        .getMinimapSession();
                        var world =
                                _959.server_waypoint.common.util.XaeroMinimapHelper.getMinimapWorld(
                                        session, Level.NETHER);
                        world.setCurrentWaypointSetId(
                                _959.server_waypoint.common.util.SyncedWaypointName
                                        .formatSyncedName("Bases"));
                        session.getWorldState().setCustomWorldPath(world.getFullPath());
                        xaero.map.mods.SupportMods.xaeroMinimap.requestWaypointsRefresh();
                        log("SELECTED minimap Nether " + world.getFullPath());
                    });
            Thread.sleep(1500);
            client(
                    () -> {
                        var support = xaero.map.mods.SupportMods.xaeroMinimap;
                        log(
